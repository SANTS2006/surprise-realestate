// Surprise Real Estate — Prisma schema for Neon PostgreSQL
// Connection strategy: `url` = pooled (runtime), `directUrl` = direct (migrations).
// See docs/database/database-design.md for rationale.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  active
  suspended
  cancelled
}

enum UserStatus {
  pending
  active
  inactive
  locked
}

enum PropertyStatus {
  active
  archived
  under_construction
}

enum UnitStatus {
  available
  occupied
  reserved
  under_maintenance
  unavailable
}

enum OwnerStatus {
  active
  inactive
}

enum TenantStatus {
  active
  inactive
  former
}

enum LeaseStatus {
  draft
  active
  expiring_soon
  expired
  terminated
  renewed
}

enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  overdue
  void
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  reversed
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  mobile_money
  cheque
  other
}

enum ExpenseStatus {
  pending_approval
  approved
  rejected
  paid
}

enum VendorStatus {
  active
  inactive
}

enum MaintenancePriority {
  low
  medium
  high
  emergency
}

enum MaintenanceStatus {
  open
  in_review
  assigned
  scheduled
  in_progress
  completed
  cancelled
}

enum WorkOrderStatus {
  pending
  scheduled
  in_progress
  completed
  cancelled
}

enum InspectionType {
  move_in
  move_out
  routine
  property
  unit
}

enum InspectionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum DocumentEntityType {
  property
  building
  unit
  tenant
  owner
  lease
  invoice
  payment
  expense
  maintenance_request
  work_order
  inspection
  vendor
  user
  organization
}

enum DocumentStatus {
  active
  archived
  deletion_pending
  deletion_failed
  deleted
}

enum NotificationType {
  rent_due
  rent_overdue
  lease_expiring
  payment_received
  maintenance_assigned
  maintenance_completed
  document_uploaded
  user_invited
  system
  inspection_scheduled
  lease_activated
  invoice_sent
  audit_remark_created
  tenant_message
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY / RBAC
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  legalName          String?            @map("legal_name")
  registrationNumber String?            @map("registration_number")
  email              String
  phone              String?
  address            String?
  city               String?
  region             String?
  country            String?
  logoDocumentId     String?            @map("logo_document_id") @db.Uuid
  settings           Json               @default("{}")
  status             OrganizationStatus @default(active)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  users               User[]
  roles               Role[]
  properties          Property[]
  owners              Owner[]
  tenants             Tenant[]
  leases              Lease[]
  invoices            Invoice[]
  payments            Payment[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  vendors             Vendor[]
  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  inspections         Inspection[]
  documents           Document[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  auditRemarks        AuditRemark[]
  propertyAssignments PropertyAssignment[]
  tenantMessages      TenantMessage[]

  @@map("organizations")
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  organizationId       String     @map("organization_id") @db.Uuid
  firstName            String     @map("first_name")
  lastName             String     @map("last_name")
  email                String
  phone                String?
  passwordHash         String     @map("password_hash")
  status               UserStatus @default(pending)
  emailVerified        Boolean    @default(false) @map("email_verified")
  mfaEnabled           Boolean    @default(false) @map("mfa_enabled")
  // Encrypted (AES-256-GCM), NOT hashed — TOTP verification requires the
  // server to recompute the current code from the raw secret, which a
  // one-way hash makes impossible. See server/src/auth/mfa.js.
  mfaSecretEncrypted   String?    @map("mfa_secret_encrypted")
  // Progressive account lockout — layered on top of the per-IP+email rate
  // limiter on /auth/login (see middleware/security.js authRateLimiter),
  // so brute-forcing survives even a distributed/rotating-IP attacker.
  failedLoginAttempts  Int        @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt          DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles     UserRole[]
  owner         Owner?
  tenant        Tenant?
  notifications Notification[]
  auditLogs     AuditLog[]
  auditRemarks  AuditRemark[]
  documentsUploaded        Document[]               @relation("DocumentUploadedBy")
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  mfaRecoveryCodes         MfaRecoveryCode[]
  propertyAssignments      PropertyAssignment[]
  tenantMessagesReceived   TenantMessage[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────
// AUTHENTICATION SUPPORT TABLES
// ─────────────────────────────────────────────────────────────────────────

// Refresh tokens are stored hashed (never the raw token) so a database leak
// alone doesn't grant usable credentials. Rotated on every use; reuse of an
// already-rotated token revokes the whole chain (theft detection).
model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id") @db.Uuid
  replacedById   String?   @map("replaced_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Single-use, short-lived, hashed at rest.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Single-use MFA backup codes, hashed at rest.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystem       Boolean @default(false) @map("is_system")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Session store table shape is managed by connect-pg-simple's own migration
// (server/src/config/session.js creates it via `createTableIfMissing`), so it
// is intentionally NOT modeled here as a Prisma model.

// ─────────────────────────────────────────────────────────────────────────
// PROPERTIES
// ─────────────────────────────────────────────────────────────────────────

model Property {
  id           String         @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  ownerId      String?        @map("owner_id") @db.Uuid
  propertyCode String         @map("property_code")
  name         String
  propertyType String         @map("property_type")
  description  String?
  address      String
  city         String?
  region       String?
  country      String?
  latitude     Decimal?       @db.Decimal(9, 6)
  longitude    Decimal?       @db.Decimal(9, 6)
  status       PropertyStatus @default(active)
  yearBuilt    Int?           @map("year_built")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        Owner?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  buildings    Building[]
  expenses     Expense[]
  maintenanceRequests MaintenanceRequest[]
  inspections  Inspection[]
  assignments  PropertyAssignment[]
  tenantMessages TenantMessage[]

  @@unique([organizationId, propertyCode])
  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@map("properties")
}

// A property_manager/agent only sees & manages properties they're
// explicitly assigned to (see docs/security/authorization.md and
// services/resourceAccess.service.js) — administrator/accountant/
// maintenance_manager/auditor get organization-wide access via their role
// permissions alone and never consult this table.
model PropertyAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  propertyId     String   @map("property_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("property_assignments")
}

model Building {
  id          String  @id @default(uuid()) @db.Uuid
  propertyId  String  @map("property_id") @db.Uuid
  name        String
  code        String?
  floors      Int?
  description String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  units    Unit[]
  tenants  Tenant[]

  @@index([propertyId])
  @@map("buildings")
}

model Unit {
  id               String     @id @default(uuid()) @db.Uuid
  buildingId       String     @map("building_id") @db.Uuid
  unitNumber       String     @map("unit_number")
  unitType         String?    @map("unit_type")
  floor            Int?
  bedrooms         Int?
  bathrooms        Int?
  area             Decimal?   @db.Decimal(10, 2)
  monthlyRent      Decimal    @map("monthly_rent") @db.Decimal(14, 2)
  securityDeposit  Decimal?   @map("security_deposit") @db.Decimal(14, 2)
  status           UnitStatus @default(available)
  description      String?

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  leases   Lease[]
  tenants  Tenant[]
  maintenanceRequests MaintenanceRequest[]
  inspections Inspection[]

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@index([status])
  @@map("units")
}

// ─────────────────────────────────────────────────────────────────────────
// PEOPLE
// ─────────────────────────────────────────────────────────────────────────

model Owner {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String?     @unique @map("user_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  address        String?
  status         OwnerStatus @default(active)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  properties   Property[]

  @@index([organizationId])
  @@map("owners")
}

model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  userId           String?      @unique @map("user_id") @db.Uuid
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  email            String?
  phone            String?
  emergencyContact Json?        @map("emergency_contact")
  status           TenantStatus @default(active)
  // Convenience "where this tenant currently lives" reference, independent
  // of Lease history — a tenant can be associated with a building (e.g. a
  // commercial building contact) or a specific unit, optionally, without
  // requiring a formal lease record to exist yet.
  buildingId       String?      @map("building_id") @db.Uuid
  unitId           String?      @map("unit_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  building     Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  leases       Lease[]
  invoices     Invoice[]
  payments     Payment[]
  maintenanceRequests MaintenanceRequest[]
  messagesSent        TenantMessage[]

  @@index([organizationId])
  @@index([buildingId])
  @@index([unitId])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────
// LEASING
// ─────────────────────────────────────────────────────────────────────────

model Lease {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  unitId          String      @map("unit_id") @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  startDate       DateTime    @map("start_date") @db.Date
  endDate         DateTime    @map("end_date") @db.Date
  monthlyRent     Decimal     @map("monthly_rent") @db.Decimal(14, 2)
  securityDeposit Decimal?    @map("security_deposit") @db.Decimal(14, 2)
  paymentDueDay   Int         @default(1) @map("payment_due_day")
  renewalDate     DateTime?   @map("renewal_date") @db.Date
  status          LeaseStatus @default(draft)
  terms           Json?
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoices     Invoice[]
  payments     Payment[]

  @@index([organizationId])
  @@index([unitId])
  @@index([tenantId])
  @@index([status])
  // Enforced again at the DB level via a partial unique index created in a
  // migration: CREATE UNIQUE INDEX ON leases (unit_id) WHERE status = 'active'
  // (Prisma cannot express partial indexes with a WHERE predicate natively
  // pre-5.x @@unique syntax, so this is added as a raw SQL migration step —
  // see database/migrations).
  @@map("leases")
}

// ─────────────────────────────────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  leaseId        String?       @map("lease_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number")
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  subtotal       Decimal       @db.Decimal(14, 2)
  tax            Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  balance        Decimal       @db.Decimal(14, 2)
  status         InvoiceStatus @default(draft)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease        Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([tenantId])
  @@index([leaseId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  leaseId        String?       @map("lease_id") @db.Uuid
  invoiceId      String?       @map("invoice_id") @db.Uuid
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD")
  paymentDate    DateTime      @map("payment_date") @db.Timestamptz
  paymentMethod  PaymentMethod @map("payment_method")
  reference      String?
  idempotencyKey String?       @unique @map("idempotency_key")
  status         PaymentStatus @default(completed)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lease        Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

model ExpenseCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  description    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  propertyId        String?       @map("property_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  vendorId          String?       @map("vendor_id") @db.Uuid
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @default("USD")
  expenseDate       DateTime      @map("expense_date") @db.Date
  description       String?
  status            ExpenseStatus @default(pending_approval)
  receiptDocumentId String?       @map("receipt_document_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  category     ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────
// OPERATIONS
// ─────────────────────────────────────────────────────────────────────────

model Vendor {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  contactPerson  String?      @map("contact_person")
  email          String?
  phone          String?
  address        String?
  serviceType    String?      @map("service_type")
  status         VendorStatus @default(active)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenses     Expense[]
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@map("vendors")
}

model MaintenanceRequest {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  propertyId     String              @map("property_id") @db.Uuid
  unitId         String?             @map("unit_id") @db.Uuid
  tenantId       String?             @map("tenant_id") @db.Uuid
  title          String
  description    String?
  priority       MaintenancePriority @default(medium)
  status         MaintenanceStatus   @default(open)
  assignedTo     String?             @map("assigned_to") @db.Uuid
  reportedAt     DateTime            @default(now()) @map("reported_at") @db.Timestamptz
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@map("maintenance_requests")
}

model WorkOrder {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  maintenanceRequestId  String          @map("maintenance_request_id") @db.Uuid
  vendorId              String?         @map("vendor_id") @db.Uuid
  assignedStaffId       String?         @map("assigned_staff_id") @db.Uuid
  scheduledDate         DateTime?       @map("scheduled_date") @db.Date
  completedDate         DateTime?       @map("completed_date") @db.Date
  estimatedCost         Decimal?        @map("estimated_cost") @db.Decimal(14, 2)
  actualCost            Decimal?        @map("actual_cost") @db.Decimal(14, 2)
  status                WorkOrderStatus @default(pending)

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  maintenanceRequest   MaintenanceRequest  @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  vendor               Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([maintenanceRequestId])
  @@index([status])
  @@map("work_orders")
}

model Inspection {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  propertyId     String            @map("property_id") @db.Uuid
  unitId         String?           @map("unit_id") @db.Uuid
  inspectorId    String?           @map("inspector_id") @db.Uuid
  inspectionDate DateTime          @map("inspection_date") @db.Date
  type           InspectionType
  condition      String?
  notes          String?
  status         InspectionStatus  @default(scheduled)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([propertyId])
  @@map("inspections")
}

// ─────────────────────────────────────────────────────────────────────────
// DOCUMENTS / NOTIFICATIONS / AUDIT
// ─────────────────────────────────────────────────────────────────────────

model Document {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  entityType             DocumentEntityType @map("entity_type")
  entityId                String             @map("entity_id") @db.Uuid
  cloudinaryPublicId      String             @unique @map("cloudinary_public_id")
  cloudinaryResourceType String             @map("cloudinary_resource_type")
  cloudinaryAssetType    String             @default("authenticated") @map("cloudinary_asset_type")
  originalFilename       String             @map("original_filename")
  mimeType               String             @map("mime_type")
  fileSize               Int                @map("file_size")
  status                 DocumentStatus     @default(active)
  uploadedBy             String             @map("uploaded_by") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploader     User         @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("documents")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String
  message        String
  readAt         DateTime?        @map("read_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  timestamp      DateTime @default(now()) @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

// A free-text remark an auditor leaves after reviewing the system — distinct
// from AuditLog (which is an automatic, per-action machine trail): this is a
// deliberate, authored note ("reviewed Q3 financials, no exceptions found").
// Immutable once created (no update/delete path), same permanence principle
// as AuditLog itself.
model AuditRemark {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  content        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("audit_remarks")
}

// One-directional: a tenant composes, the assigned agent(s) for their
// property receive it (in-app + email, see tenantMessage.service.js).
// No reply/thread support yet — a natural follow-up, not built here.
model TenantMessage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  recipientId    String    @map("recipient_id") @db.Uuid
  propertyId     String    @map("property_id") @db.Uuid
  content        String
  readAt         DateTime? @map("read_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([tenantId])
  @@index([recipientId])
  @@map("tenant_messages")
}
